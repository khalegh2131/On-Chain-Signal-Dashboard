# Resilient install defaults for slow or unstable links.
#
# The web3 dependency graph pulls several hundred tarballs from the public
# registry; a single mid-download connection reset would otherwise roll back the
# whole install. Retries are cheap because npm caches every completed tarball.
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=900000

# Fewer parallel sockets keeps long-lived downloads from being reset under
# constrained bandwidth, at the cost of a slower first run.
maxsockets=8

# Keep install output focused on dependency resolution.
audit=false
fund=false
