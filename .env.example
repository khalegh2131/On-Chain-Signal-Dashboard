# ── RPC provider ────────────────────────────────────────────────────────────
# Alchemy API key. Powers the multi-chain RPC transports and NFT metadata reads.
# Public RPC fallbacks are used automatically when this is empty.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# ── Wallet connections ──────────────────────────────────────────────────────
# WalletConnect Cloud project id. Required by RainbowKit's WalletConnect connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Market data ─────────────────────────────────────────────────────────────
# CoinGecko API key (Pro or Demo). Used for token prices, charts, and NFT floors.
# A `CG-` prefixed key is treated as a Pro key and routed to the Pro host; a
# Demo key is sent to the public host. Leave empty to use the keyless tier.
COINGECKO_API_KEY=

# ── DeFi positions ──────────────────────────────────────────────────────────
# The Graph API key. Uniswap v3 and Aave v3 positions are published on the
# decentralized network, which answers 401 until a key is present. Without it
# the DeFi tab reports those protocols as unconfigured instead of guessing.
GRAPH_API_KEY=

# Aave v3 subgraph URL, e.g. a gateway.thegraph.com deployment you have access
# to. Aave positions are skipped (with a note) when this is empty.
AAVE_V3_SUBGRAPH_URL=

# ── Caching ─────────────────────────────────────────────────────────────────
# Optional Redis connection string for caching upstream API responses server-side.
REDIS_URL=
